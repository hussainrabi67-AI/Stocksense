# ==============================================================================
# STOCKSENSE ENVIRONMENT CONFIGURATION
# Browser-safe client environment variables
# ==============================================================================

# Supabase Credentials (from your Supabase project settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# n8n AI Webhook URL (from your n8n workflow webhook trigger node)
VITE_N8N_AI_WEBHOOK_URL=https://your-n8n-instance.com/webhook/stocksense-ai-copilot

# Next.js Compatibility aliases (if exported to Next.js project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_N8N_AI_WEBHOOK_URL=https://your-n8n-instance.com/webhook/stocksense-ai-copilot

# SECURITY NOTICE:
# DO NOT place service_role secret keys, database passwords, or OpenRouter keys here!
# Those are configured securely inside n8n and Supabase dashboard.
